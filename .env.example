# NexAgent environment template.
# Copy this file to .env and fill in your own values.

# App runtime
NEXAGENT_VERSION=0.1.0
NEXAGENT_DEBUG=0
NEXAGENT_CORS_ORIGINS=*
NEXAGENT_DATA_DIR=.nexagent

# Long-term memory master switch (overrides config.yaml `memory.enabled` when set).
# Leave unset to control it from config.yaml / the Memory page toggle instead.
# NEXAGENT_MEMORY_ENABLED=1

# LLM providers
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional web search provider
TAVILY_API_KEY=

# Local infrastructure defaults (bring up with: docker compose up -d postgres redis milvus neo4j minio)
POSTGRES_USER=nexagent
POSTGRES_PASSWORD=nexagent
POSTGRES_DB=nexagent
# Async driver (+asyncpg) is required; a bare postgresql:// URL is auto-upgraded.
DATABASE_URL=postgresql+asyncpg://nexagent:nexagent@localhost:5432/nexagent
REDIS_URL=redis://localhost:6379/0

# Knowledge services — production path (Milvus vectors + Neo4j graph)
NEXAGENT_KB_STORAGE=postgres
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexagent

# To run fully offline against SQLite instead, comment out DATABASE_URL above and set:
#   NEXAGENT_DB_BACKEND=sqlite
#   NEXAGENT_KB_STORAGE=legacy
