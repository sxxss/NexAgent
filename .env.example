# NexAgent environment template.
# Copy this file to .env and fill in your own values.

# App runtime
NEXAGENT_VERSION=0.1.0
NEXAGENT_DEBUG=0
NEXAGENT_CORS_ORIGINS=*
NEXAGENT_DATA_DIR=.nexagent

# LLM providers
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional web search provider
TAVILY_API_KEY=

# Local infrastructure defaults
POSTGRES_USER=nexagent
POSTGRES_PASSWORD=nexagent
POSTGRES_DB=nexagent
DATABASE_URL=postgresql://nexagent:nexagent@localhost:5432/nexagent
REDIS_URL=redis://localhost:6379/0

# Knowledge services
MILVUS_HOST=localhost
MILVUS_PORT=19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexagent
